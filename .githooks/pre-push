#!/usr/bin/env bash
# Checks each pushed ref against CONTRIBUTING.md (branch and tag names; main and develop change only
# through pull requests), then runs the repo hygiene check on every commit about to be pushed, so
# nothing reaches GitHub through history either (a secret added in one commit and deleted in the
# next is still pushed).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
check="$root/scripts/check-repo-hygiene.sh"
conventions="$root/scripts/check-conventions.sh"

while read -r _local_ref local_sha remote_ref remote_sha; do
  bash "$conventions" --push "$1" "$remote_ref" "$local_sha" "$remote_sha" </dev/null
  [[ "$local_sha" =~ ^0+$ ]] && continue          # deleting a remote branch: nothing to check
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    commits="$(git rev-list "$local_sha" --not --remotes)"   # new branch: commits not on any remote
  else
    commits="$(git rev-list "$remote_sha..$local_sha")"
  fi
  for commit in $commits; do
    bash "$check" "$commit"
  done
done
