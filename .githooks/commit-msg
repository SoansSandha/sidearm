#!/usr/bin/env bash
# Checks the commit message before the commit is created: the Conventional Commits format
# (CONTRIBUTING.md), then secrets and personal data (.claude/rules/git-and-privacy.md).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
bash "$root/scripts/check-conventions.sh" --message "$1"
exec bash "$root/scripts/check-repo-hygiene.sh" --message "$1"
