root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# Matches kotlin.code.style=official in gradle.properties; ktlint reads this from Phase 1.
ktlint_code_style = intellij_idea
# Compose names composable functions like types (MainScreen), which ktlint's naming rule would reject.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
